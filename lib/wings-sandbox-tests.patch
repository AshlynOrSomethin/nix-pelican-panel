+func requireSpecialMode(t *testing.T, path string, mode os.FileMode) {
+	t.Helper()
+	if err := os.Chmod(path, mode); err != nil {
+		if errors.Is(err, syscall.EPERM) {
+			t.Skipf("environment does not permit special permission bits: %v", err)
+		}
+		t.Fatal(err)
+	}
